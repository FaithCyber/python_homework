# TASK 12: READ MINUTES
# =========================
def read_file(path):
    fields = []
    rows = []

    with open(path, "r") as file:
        reader = csv.reader(file)

        for i, row in enumerate(reader):
            if i == 0:
                fields = row
            else:
                rows.append(tuple(row))

    return {"fields": fields, "rows": rows}


def read_minutes():
    return (
        read_file("../csv/minutes1.csv"),
        read_file("../csv/minutes2.csv")
    )


minutes1, minutes2 = read_minutes()


# =========================
# TASK 13: SET UNION
# =========================
def create_minutes_set():
    return set(minutes1["rows"]).union(set(minutes2["rows"]))


minutes_set = create_minutes_set()


# =========================
# TASK 14: DATETIME CONVERSION
# =========================
def create_minutes_list():
    return list(map(
        lambda x: (x[0], datetime.strptime(x[1], "%B %d, %Y")),
        list(minutes_set)
    ))


minutes_list = create_minutes_list()


# =========================
# TASK 15: WRITE SORTED FILE
# =========================
def write_sorted_list():

    sorted_list = sorted(minutes_list, key=lambda x: x[1])

    converted = list(map(
        lambda x: (x[0], x[1].strftime("%B %d, %Y")),
        sorted_list
    ))

    with open("./minutes.csv", "w", newline="") as file:
        writer = csv.writer(file)

        writer.writerow(minutes1["fields"])

        for row in converted:
            writer.writerow(row)

    return converted


final_minutes = write_sorted_list() 